rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {

    function esTextoValido(valor, maxLargo) {
      return valor is string && valor.size() <= maxLargo;
    }

    function esTextoOpcionalValido(valor, maxLargo) {
      return valor == null || (valor is string && valor.size() <= maxLargo);
    }

    function esTextoRequerido(valor, maxLargo) {
      return valor is string && valor.size() > 0 && valor.size() <= maxLargo;
    }

    // Para los contadores de personas afectadas (heridos/fallecidos/
    // desaparecidos): siempre tienen que llegar como número entero,
    // nunca negativo, con un tope razonable contra errores/abuso.
    function esConteoValido(valor) {
      return valor is int && valor >= 0 && valor <= 99999;
    }

    function esListaFotosValida(valor) {
      return valor is list && valor.size() <= 3;
    }

    function esListaItemsValida(valor) {
      return valor is list && valor.size() <= 10;
    }

    function timestampEsDelServidor() {
      return request.resource.data.timestamp == request.time;
    }

    // Verifica que, comparado con el documento actual, el único campo que
    // cambió en esta escritura sea exactamente "campo".
    function soloCambioDeCampo(campo) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([campo]);
    }

    function esVotoDesactualizado() {
      return soloCambioDeCampo('marcasDesactualizado') &&
        request.resource.data.marcasDesactualizado == resource.data.marcasDesactualizado + 1;
    }

    function esVotoAbuso() {
      return soloCambioDeCampo('reportesAbuso') &&
        request.resource.data.reportesAbuso == resource.data.reportesAbuso + 1;
    }

    // Personal administrativo/verificado: tiene que haber iniciado sesión
    // con Google, ser del dominio institucional, Y tener un documento propio
    // en la colección admins_permitidos (un documento por correo autorizado,
    // usando el correo como ID; el contenido no importa, solo que exista).
    //
    // Esa whitelist NO vive en este archivo a propósito: firestore.rules se
    // sube a un repositorio público. El exists() de abajo consulta esa
    // colección internamente para evaluar la regla — eso funciona SIEMPRE,
    // sin importar la restricción de lectura que tiene esa colección más
    // abajo (esa restricción es para el navegador, no para las reglas mismas).
    //
    // IMPORTANTE: esta función tiene que vivir DENTRO de este match, porque
    // usa la variable "database" que solo existe acá adentro.
    function esCorreoAdminPermitido() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower().matches('^[^@]+@correounivalle[.]edu[.]co$') &&
        exists(/databases/$(database)/documents/admins_permitidos/$(request.auth.token.email.lower()));
    }

    // Exige que el campo "verificado"/"autorEmail" que llega en la creación
    // coincida de verdad con quién está autenticado: si es admin permitido,
    // solo puede marcarse verificado=true con SU PROPIO correo; si no, tiene
    // que mandar verificado=false y autorEmail=null. Así nadie puede
    // falsificar el sello de "fuente verificada" ni hacerse pasar por otra
    // cuenta, sin importar qué mande el navegador.
    function autoriaValida() {
      return (
        esCorreoAdminPermitido() &&
        request.resource.data.verificado == true &&
        request.resource.data.autorEmail == request.auth.token.email
      ) || (
        request.resource.data.verificado == false &&
        request.resource.data.autorEmail == null
      );
    }

    // -------------------- Reportes de ayuda (mapa) --------------------
    match /reportes_ayuda/{docId} {
      allow read: if true;

      allow create: if timestampEsDelServidor() &&
        esTextoValido(request.resource.data.tipo, 30) &&
        esTextoRequerido(request.resource.data.descripcion, 300) &&
        esTextoRequerido(request.resource.data.localidad, 100) &&
        esTextoOpcionalValido(request.resource.data.contacto, 120) &&
        esListaFotosValida(request.resource.data.fotos) &&
        esConteoValido(request.resource.data.heridos) &&
        esConteoValido(request.resource.data.fallecidos) &&
        esConteoValido(request.resource.data.desaparecidos) &&
        request.resource.data.estado == 'activo' &&
        request.resource.data.personasAyudando == 0 &&
        request.resource.data.estadoOperativo == '' &&
        request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.reportesAbuso == 0 &&
        request.resource.data.marcasDesactualizado == 0 &&
        autoriaValida();

      allow update: if (
        soloCambioDeCampo('estado') &&
        resource.data.estado == 'activo' &&
        request.resource.data.estado == 'atendido'
      ) || (
        // Alguien se suma como "ayudando aquí" (conteo en vivo, sube de a 1).
        soloCambioDeCampo('personasAyudando') &&
        request.resource.data.personasAyudando == resource.data.personasAyudando + 1
      ) || (
        // Alguien deja de estar en el sitio (baja de a 1, nunca bajo 0).
        soloCambioDeCampo('personasAyudando') &&
        request.resource.data.personasAyudando == resource.data.personasAyudando - 1 &&
        resource.data.personasAyudando > 0
      ) || (
        // Cualquiera puede actualizar el estado operativo del punto
        // (necesita personas / necesita insumos / ya está lleno).
        soloCambioDeCampo('estadoOperativo') &&
        request.resource.data.estadoOperativo in ['necesita_personas', 'necesita_insumos', 'lleno', '']
      ) || esVotoDesactualizado() || esVotoAbuso();

      allow delete: if false;
    }

    // -------------------- Desaparecidos y encontrados (personas y mascotas) --------------------
    match /desaparecidos/{docId} {
      allow read: if true;

      allow create: if timestampEsDelServidor() &&
        request.resource.data.modo in ['busco', 'encontre'] &&
        request.resource.data.tipoSujeto in ['persona', 'mascota'] &&
        (request.resource.data.modo == 'busco'
          ? esTextoRequerido(request.resource.data.nombre, 100)
          : esTextoOpcionalValido(request.resource.data.nombre, 100)) &&
        esTextoRequerido(request.resource.data.descripcion, 400) &&
        esTextoOpcionalValido(request.resource.data.localidad, 100) &&
        esTextoOpcionalValido(request.resource.data.ultimaUbicacion, 150) &&
        esListaFotosValida(request.resource.data.fotos) &&
        esTextoRequerido(request.resource.data.contacto, 120) &&
        (request.resource.data.modo == 'busco'
          ? request.resource.data.estado == 'buscando'
          : request.resource.data.estado == 'disponible') &&
        request.resource.data.reportesAbuso == 0 &&
        request.resource.data.marcasDesactualizado == 0 &&
        autoriaValida();

      allow update: if (
        soloCambioDeCampo('estado') && (
          (resource.data.modo == 'busco' && resource.data.estado == 'buscando' && request.resource.data.estado == 'encontrado') ||
          (resource.data.modo == 'encontre' && resource.data.estado == 'disponible' && request.resource.data.estado == 'reclamado')
        )
      ) || esVotoDesactualizado() || esVotoAbuso();

      allow delete: if false;
    }

    // -------------------- Comunidad (peticiones y ofertas) --------------------
    match /comunidad_servicios/{docId} {
      allow read: if true;

      allow create: if timestampEsDelServidor() &&
        request.resource.data.tipoPublicacion in ['peticion', 'oferta'] &&
        esTextoValido(request.resource.data.categoria, 40) &&
        esTextoRequerido(request.resource.data.servicio, 100) &&
        esTextoOpcionalValido(request.resource.data.descripcion, 300) &&
        esListaItemsValida(request.resource.data.items) &&
        esTextoOpcionalValido(request.resource.data.zona, 120) &&
        esTextoRequerido(request.resource.data.contacto, 120) &&
        request.resource.data.estado == 'abierta' &&
        request.resource.data.numAyudantes == 0 &&
        request.resource.data.numEntregas == 0 &&
        request.resource.data.reportesAbuso == 0 &&
        request.resource.data.marcasDesactualizado == 0 &&
        autoriaValida();

      allow update: if (
        // Quien publicó cancela (ya no aplica / ya no hay disponibilidad).
        soloCambioDeCampo('estado') &&
        resource.data.estado == 'abierta' &&
        request.resource.data.estado == 'cancelada'
      ) || (
        // Quien publicó confirma que ya se resolvió. Solo si alguien ya
        // la había tomado antes (si nadie se ofreció, no hay nada que
        // "confirmar" — en ese caso lo que aplica es cancelar).
        soloCambioDeCampo('estado') &&
        resource.data.estado == 'abierta' &&
        request.resource.data.estado == 'atendida' &&
        resource.data.numAyudantes > 0
      ) || (
        // Cualquiera puede "tomarla" (+1), mientras siga abierta. No hay
        // límite de cuántas personas pueden tomarla — a propósito.
        soloCambioDeCampo('numAyudantes') &&
        resource.data.estado == 'abierta' &&
        request.resource.data.numAyudantes == resource.data.numAyudantes + 1
      ) || (
        // Alguien que ya la tomó confirma que cumplió su parte (+1),
        // nunca más veces que personas la hayan tomado.
        soloCambioDeCampo('numEntregas') &&
        request.resource.data.numEntregas == resource.data.numEntregas + 1 &&
        request.resource.data.numEntregas <= resource.data.numAyudantes
      ) || esVotoDesactualizado() || esVotoAbuso();

      allow delete: if false;
    }

    // -------------------- Whitelist de administradores --------------------
    // Un documento por correo autorizado (ID = correo en minúsculas, ej:
    // "juan.perez@correounivalle.edu.co"). El contenido del documento no
    // importa, solo que exista. Se administra a mano desde Firebase
    // Console → Firestore → Datos.
    //
    // Nadie puede LISTAR esta colección (no se puede ver quién más está
    // autorizado), pero una persona autenticada SÍ puede consultar (get)
    // el documento que coincide con SU PROPIO correo — así el login puede
    // preguntar "¿estoy yo?" sin exponer al resto de la lista.
    match /admins_permitidos/{correo} {
      allow get: if request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == correo;
      allow list: if false;
      allow write: if false;
    }

    // Cualquier otra colección no listada arriba queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
