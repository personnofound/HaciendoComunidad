rules_version = '2';
service cloud.firestore {

  function esTextoValido(valor, maxLargo) {
    return valor is string && valor.size() <= maxLargo;
  }

  function esTextoOpcionalValido(valor, maxLargo) {
    return valor == null || (valor is string && valor.size() <= maxLargo);
  }

  function esTextoRequerido(valor, maxLargo) {
    return valor is string && valor.size() > 0 && valor.size() <= maxLargo;
  }

  function timestampEsDelServidor() {
    return request.resource.data.timestamp == request.time;
  }

  // Verifica que, comparado con el documento actual, el único campo que
  // cambió en esta escritura sea exactamente "campo".
  function soloCambioDeCampo(campo) {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly([campo]);
  }

  function esVotoDesactualizado() {
    return soloCambioDeCampo('marcasDesactualizado') &&
      request.resource.data.marcasDesactualizado == resource.data.marcasDesactualizado + 1;
  }

  function esVotoAbuso() {
    return soloCambioDeCampo('reportesAbuso') &&
      request.resource.data.reportesAbuso == resource.data.reportesAbuso + 1;
  }

  match /databases/{database}/documents {

    // -------------------- Reportes de ayuda (mapa) --------------------
    match /reportes_ayuda/{docId} {
      allow read: if true;

      allow create: if timestampEsDelServidor() &&
        esTextoValido(request.resource.data.tipo, 30) &&
        esTextoRequerido(request.resource.data.descripcion, 300) &&
        esTextoRequerido(request.resource.data.localidad, 100) &&
        esTextoOpcionalValido(request.resource.data.contacto, 120) &&
        request.resource.data.estado == 'activo' &&
        request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.reportesAbuso == 0 &&
        request.resource.data.marcasDesactualizado == 0;

      allow update: if (
        soloCambioDeCampo('estado') &&
        resource.data.estado == 'activo' &&
        request.resource.data.estado == 'atendido'
      ) || esVotoDesactualizado() || esVotoAbuso();

      allow delete: if false;
    }

    // -------------------- Desaparecidos y encontrados (personas y mascotas) --------------------
    match /desaparecidos/{docId} {
      allow read: if true;

      allow create: if timestampEsDelServidor() &&
        request.resource.data.modo in ['busco', 'encontre'] &&
        request.resource.data.tipoSujeto in ['persona', 'mascota'] &&
        (request.resource.data.modo == 'busco'
          ? esTextoRequerido(request.resource.data.nombre, 100)
          : esTextoOpcionalValido(request.resource.data.nombre, 100)) &&
        esTextoRequerido(request.resource.data.descripcion, 400) &&
        esTextoOpcionalValido(request.resource.data.localidad, 100) &&
        esTextoOpcionalValido(request.resource.data.ultimaUbicacion, 150) &&
        esTextoOpcionalValido(request.resource.data.fotoUrl, 500) &&
        esTextoRequerido(request.resource.data.contacto, 120) &&
        (request.resource.data.modo == 'busco'
          ? request.resource.data.estado == 'buscando'
          : request.resource.data.estado == 'disponible') &&
        request.resource.data.reportesAbuso == 0 &&
        request.resource.data.marcasDesactualizado == 0;

      allow update: if (
        soloCambioDeCampo('estado') && (
          (resource.data.modo == 'busco' && resource.data.estado == 'buscando' && request.resource.data.estado == 'encontrado') ||
          (resource.data.modo == 'encontre' && resource.data.estado == 'disponible' && request.resource.data.estado == 'reclamado')
        )
      ) || esVotoDesactualizado() || esVotoAbuso();

      allow delete: if false;
    }

    // -------------------- Comunidad (peticiones y ofertas) --------------------
    match /comunidad_servicios/{docId} {
      allow read: if true;

      allow create: if timestampEsDelServidor() &&
        request.resource.data.tipoPublicacion in ['peticion', 'oferta'] &&
        esTextoValido(request.resource.data.categoria, 40) &&
        esTextoRequerido(request.resource.data.servicio, 100) &&
        esTextoOpcionalValido(request.resource.data.descripcion, 300) &&
        esTextoOpcionalValido(request.resource.data.zona, 120) &&
        esTextoRequerido(request.resource.data.contacto, 120) &&
        request.resource.data.estado == 'abierto' &&
        request.resource.data.reportesAbuso == 0 &&
        request.resource.data.marcasDesactualizado == 0;

      allow update: if (
        soloCambioDeCampo('estado') &&
        resource.data.estado == 'abierto' &&
        request.resource.data.estado == 'cubierto'
      ) || esVotoDesactualizado() || esVotoAbuso();

      allow delete: if false;
    }

    // Cualquier otra colección no listada arriba queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
