rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de personas/mascotas buscadas o encontradas.
    match /desaparecidos/{archivo} {
      allow read: if true;

      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Nadie puede reemplazar ni borrar una foto ya subida desde el cliente.
      allow update, delete: if false;
    }

    // Fotos de los reportes del mapa de ayuda.
    match /reportes_ayuda/{archivo} {
      allow read: if true;

      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }

    // Cualquier otra ruta queda bloqueada por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
